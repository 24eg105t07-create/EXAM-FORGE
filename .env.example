# ==========================================
# ExamForge Environment Configuration (.env)
# ==========================================
# Copy this file to .env and configure values for your environment.
# Never commit real credentials or production secrets to source control.

# Application Profile: 'dev' (H2 MySQL-compatibility mode, zero setup) or 'mysql' (MySQL 8 database)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Configuration (Used when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=examforge
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration
# Must be at least 256 bits (32+ alphanumeric/special characters)
JWT_SECRET=ExamForgeSecretKeyMustBeAtLeast256BitsLongForHMACSHA256Signature2026Secure!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider Configuration
# Supported providers: 'LOCAL_DEMO', 'GEMINI', 'OPENAI'
AI_PROVIDER=LOCAL_DEMO
# Optional API keys for AI generation (if AI_PROVIDER is GEMINI or OPENAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Document Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# College Localization
COLLEGE_TIMEZONE=Asia/Kolkata

# Initial Management Bootstrap (Used only on initial startup if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=Admin@ExamForge2026
BOOTSTRAP_ADMIN_NAME=College SuperAdmin

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
